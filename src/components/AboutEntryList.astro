---
import type { AboutEntry } from '../lib/content-schema';

interface Props {
  entries: AboutEntry[];
  id: string;
  labelledBy: string;
  featured?: boolean;
}

const { entries, id, labelledBy, featured = false } = Astro.props;
const chronologicalEntries = [...entries].sort((left, right) =>
  right.period.slice(0, 7).localeCompare(left.period.slice(0, 7)),
);
---

<ol class="about-entry-list" aria-labelledby={labelledBy} data-about-list={id} role="list">
  {chronologicalEntries.map((entry) => (
    <li>
      {featured ? (
        <div class="featured-entry">
          <span class="entry-title" lang="en">{entry.title}</span>
          <span class="entry-period">{entry.period}</span>
          <div class="entry-body">
            <p lang="ko" data-language-fragment="ko">{entry.description.ko}</p>
            <p lang="en" data-language-fragment="en" hidden>{entry.description.en}</p>
          </div>
        </div>
      ) : (
        <details class="entry-details">
          <summary>
            <span class="entry-title" lang="en">{entry.title}</span>
            <span class="entry-period">{entry.period}</span>
            <span class="entry-action">
              <span class="entry-more">
                <span lang="ko" data-language-fragment="ko">자세히 보기</span>
                <span lang="en" data-language-fragment="en" hidden>Details</span>
              </span>
              <span class="entry-less">
                <span lang="ko" data-language-fragment="ko">접기</span>
                <span lang="en" data-language-fragment="en" hidden>Close</span>
              </span>
            </span>
          </summary>
          <div class="entry-body">
            <p lang="ko" data-language-fragment="ko">{entry.description.ko}</p>
            <p lang="en" data-language-fragment="en" hidden>{entry.description.en}</p>
            {entry.link && (
              <p class="entry-link">
                <a href={entry.link.href} rel="noreferrer">
                  <span lang="ko" data-language-fragment="ko">{entry.link.label.ko}</span>
                  <span lang="en" data-language-fragment="en" hidden>{entry.link.label.en}</span>
                </a>
              </p>
            )}
          </div>
        </details>
      )}
    </li>
  ))}
</ol>

<style>
  .about-entry-list { position: relative; margin: 0; padding: 0 0 0 2rem; list-style: none; }
  .about-entry-list::before { content: ''; position: absolute; top: 1rem; bottom: 1rem; left: 0.5rem; width: 1px; background: var(--line); }
  .about-entry-list li { position: relative; margin: 0 0 1.375rem; }
  .about-entry-list li:last-child { margin-bottom: 0; }
  .about-entry-list li::before { content: ''; position: absolute; z-index: 1; top: 1.02rem; left: -1.75rem; width: 0.5rem; height: 0.5rem; border: 1px solid var(--accent); border-radius: 50%; background: var(--paper); }
  .featured-entry { padding: 0.625rem 0 0.125rem; }
  .featured-entry .entry-title, .featured-entry .entry-period { display: block; }
  .featured-entry .entry-period { margin-top: 0.125rem; }
  .featured-entry .entry-body { padding: 0.75rem 0 0; }
  .entry-details summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.125rem 1rem;
    align-items: center;
    padding: 0.625rem 0 0.25rem;
    list-style: none;
    cursor: pointer;
  }
  .entry-details summary::-webkit-details-marker { display: none; }
  .entry-details summary:focus-visible { outline: 0.1875rem solid var(--accent); outline-offset: 0.1875rem; box-shadow: none; }
  .entry-title { grid-column: 1; min-width: 0; font-family: var(--serif-display); font-size: 1.3125rem; line-height: 1.25; overflow-wrap: anywhere; }
  .entry-period { grid-column: 1; color: var(--muted); font-family: var(--mono); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .entry-action { grid-column: 2; grid-row: 1 / 3; color: var(--accent); font-family: var(--serif-ko); font-size: 0.8125rem; white-space: nowrap; }
  .entry-action [lang="en"] { font-family: var(--serif-display); font-size: 1rem; }
  .entry-less, .entry-details[open] .entry-more { display: none; }
  .entry-details[open] .entry-less { display: inline; }
  .entry-body { padding: 0.625rem 0 0; }
  .entry-body p { margin: 0; font-family: var(--serif-ko); font-size: 0.9375rem; line-height: 1.85; word-break: keep-all; }
  .entry-body p:lang(en) { font-family: var(--serif-display); font-size: 1.1875rem; line-height: 1.65; word-break: normal; }
  .entry-body .entry-link { margin-top: 0.625rem; }
  .entry-link a { color: var(--accent); }
  @media (max-width: 45rem) {
    .entry-title { font-size: 1.1875rem; }
    .entry-details summary { gap: 0.125rem 0.625rem; }
  }
</style>
