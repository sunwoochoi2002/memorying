---
import { formatWritingDate, type WritingArticle } from '../lib/writing';

interface Props {
  item: WritingArticle;
}

const { item } = Astro.props;
---

<p class="meta" lang={item.originalLanguage}>
  <span>{item.type === 'essay' ? 'Essay' : 'Note'}</span>
  <span> · <time datetime={item.publishedAt.toISOString()}>{formatWritingDate(item.publishedAt)}</time></span>
  {item.updatedAt && (
    <span> · Updated <time datetime={item.updatedAt.toISOString()}>{formatWritingDate(item.updatedAt)}</time></span>
  )}
</p>
