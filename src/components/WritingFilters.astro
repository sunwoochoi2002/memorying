<div class="filters" data-writing-filters hidden>
  <fieldset class="filter-group" data-filter-group="type">
    <legend>Type</legend>
    <button class="filter-button" type="button" data-value="all" aria-pressed="true">All</button>
    <button class="filter-button" type="button" data-value="essay" aria-pressed="false">Essay</button>
    <button class="filter-button" type="button" data-value="note" aria-pressed="false">Note</button>
  </fieldset>
  <p aria-live="polite" data-filter-status></p>
  <p class="empty-state" data-filter-empty hidden>
    이 조건에 해당하는 글이 아직 없습니다.
    <button class="filter-button" type="button" data-reset-filters>모든 글 보기</button>
  </p>
</div>

<script>
  import { buildWritingSearch, parseWritingFilters, type WritingFilters } from '../lib/writing';

  const typeLabels: Record<WritingFilters['type'], string> = {
    all: 'All',
    essay: 'Essay',
    note: 'Note',
  };
  const applyAll = (filters: WritingFilters) => {
    for (const archive of document.querySelectorAll<HTMLElement>('[data-writing-archive]')) {
      const root = archive.querySelector<HTMLElement>('[data-writing-filters]');
      const items = [...archive.querySelectorAll<HTMLElement>('[data-writing-item]')];
      if (!root) continue;

      const status = root.querySelector<HTMLElement>('[data-filter-status]');
      const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
      root.hidden = false;
      let visible = 0;
      for (const item of items) {
        item.hidden = filters.type !== 'all' && item.dataset.type !== filters.type;
        if (!item.hidden) visible += 1;
      }

      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-filter-group="type"] [data-value]')) {
        button.setAttribute('aria-pressed', String(button.dataset.value === filters.type));
      }

      if (status) {
        status.textContent = `Showing ${visible} writing item${visible === 1 ? '' : 's'}: Type ${typeLabels[filters.type]}.`;
      }
      if (empty) empty.hidden = visible !== 0;
    }
  };

  const read = () => parseWritingFilters(window.location.search);
  applyAll(read());

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target;
    const archive = target.closest<HTMLElement>('[data-writing-archive]');
    if (!archive) return;
    const root = archive.querySelector<HTMLElement>('[data-writing-filters]');
    if (!root) return;

    const reset = target.closest<HTMLButtonElement>('[data-reset-filters]');
    if (reset && root.contains(reset)) {
      if (read().type === 'all' && window.location.search === '') return;
      history.pushState({}, '', window.location.pathname);
      applyAll({ type: 'all' });
      root.querySelector<HTMLButtonElement>('[data-filter-group="type"] [data-value="all"]')?.focus();
      return;
    }

    const button = target.closest<HTMLButtonElement>('[data-value]');
    if (!button || !root.contains(button)) return;
    const next = { type: button.dataset.value as WritingFilters['type'] };
    const nextUrl = `${window.location.pathname}${buildWritingSearch(next)}`;
    if (nextUrl === `${window.location.pathname}${window.location.search}`) return;
    history.pushState({}, '', nextUrl);
    applyAll(next);
  });

  window.addEventListener('popstate', () => applyAll(read()));
</script>
