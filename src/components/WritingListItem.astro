---
import { findWritingCategory, formatWritingDate, originalTranslation, type WritingArticle } from '../lib/writing';
import { loadWritingCategories } from '../lib/writing-categories';

interface Props {
  item: WritingArticle;
  headingLevel?: 2 | 3;
  compact?: boolean;
  /** Category pages leave the label out: every row there shares it. */
  showCategory?: boolean;
}

const { item, headingLevel = 2, compact = false, showCategory = true } = Astro.props;
const translation = originalTranslation(item);
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const category = findWritingCategory(loadWritingCategories(), item.category);
---

<article class:list={['writing-list-item', { 'writing-list-item--compact': compact }]}>
  <div class="writing-list-item__copy">
    <Heading lang={item.originalLanguage}><a href={`/writing/${item.slug}/`}>{translation.title}</a></Heading>
  </div>
  <p class="writing-list-item__meta">
    {showCategory && <span lang="ko">{category.name.ko}</span>}
    <time lang={item.originalLanguage} datetime={item.publishedAt.toISOString()}>
      {formatWritingDate(item.publishedAt)}
    </time>
  </p>
</article>
