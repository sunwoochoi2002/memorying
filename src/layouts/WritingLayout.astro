---
import { Image } from 'astro:assets';
import ContentMetadata from '../components/ContentMetadata.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import BaseLayout from './BaseLayout.astro';
import { originalTranslation, type WritingArticle } from '../lib/writing';

interface Props {
  item: WritingArticle;
}

const { item } = Astro.props;
const original = originalTranslation(item);
const { ko, en } = item.translations;
const { originalLanguage } = item;
---

<BaseLayout
  title={original.title}
  lang={originalLanguage}
  canonicalUrl={item.canonicalUrl}
  type="article"
>
  <article class="container article">
    <div class="column">
      <header class="article-header">
        <ContentMetadata item={item} />
        <h1 lang="ko" data-language-fragment="ko" hidden={originalLanguage !== 'ko'}>{ko.title}</h1>
        <h1 lang="en" data-language-fragment="en" hidden={originalLanguage !== 'en'}>{en.title}</h1>
        <LanguageToggle initialLanguage={originalLanguage} originalLanguage={originalLanguage} />
      </header>
      {item.coverImage && item.coverImageAlt && (
        <div
          class="writing-cover"
          data-writing-cover
          data-alt-ko={item.coverImageAlt.ko}
          data-alt-en={item.coverImageAlt.en}
        >
          <Image
            src={item.coverImage}
            alt={item.coverImageAlt[originalLanguage]}
            widths={[640, 960, 1280]}
            sizes="(max-width: 42rem) calc(100vw - 3rem), 624px"
          />
        </div>
      )}
      <div class="prose">
        <div lang="ko" data-language-panel="ko" hidden={originalLanguage !== 'ko'}><slot name="ko" /></div>
        <div lang="en" data-language-panel="en" hidden={originalLanguage !== 'en'}><slot name="en" /></div>
      </div>
      {item.type === 'essay' && <NewsletterSignup id="essay-end" />}
      <p class="article-back"><a class="text-link" href="/writing/" lang="en">← Back to Writing</a></p>
    </div>
  </article>
</BaseLayout>
