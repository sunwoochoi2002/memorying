---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import AboutEntryList from '../components/AboutEntryList.astro';

const profile = await getEntry('about', 'profile');
if (!profile) throw new Error('Missing src/content/about/profile.yaml');
---

<BaseLayout title="About" description="About Sunwoo Choi, his interests, experience, and projects.">
  <section class="container section">
    <div class="column">
      <h1 class="section-title" lang="en">{profile.data.labels.pageTitle}</h1>
      <LanguageToggle initialLanguage="ko" />

      <div class="about-intro">
        {profile.data.intro.ko.map((paragraph) => <p lang="ko" data-language-fragment="ko">{paragraph}</p>)}
        {profile.data.intro.en.map((paragraph) => <p lang="en" data-language-fragment="en" hidden>{paragraph}</p>)}
      </div>

      {profile.data.sections.map((section) => (
        <section class="about-section" aria-labelledby={`${section.id}-heading`}>
          <h2 id={`${section.id}-heading`} lang="en">{section.heading}</h2>
          <AboutEntryList id={section.id} entries={section.entries} labelledBy={`${section.id}-heading`} featured={section.featured} labels={profile.data.labels} />
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro { margin-top: 1.75rem; }
  .about-intro p { margin: 0 0 1rem; font-family: var(--serif-ko); font-size: 1.0625rem; line-height: 1.85; word-break: keep-all; }
  .about-intro p:lang(en) { font-family: var(--serif-display); font-size: 1.3125rem; line-height: 1.65; word-break: normal; }
  .about-section { margin-top: 3.5rem; }
  .about-section h2 { margin: 0 0 1.25rem; color: var(--accent); font-family: var(--serif-display); font-size: 1.625rem; font-style: italic; font-weight: 400; line-height: 1.3; }
  @media (max-width: 45rem) {
    .about-intro p { font-size: 1rem; }
    .about-intro p:lang(en) { font-size: 1.25rem; }
    .about-section { margin-top: 3rem; }
    .about-section h2 { font-size: 1.375rem; }
  }
</style>
