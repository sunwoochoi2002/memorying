---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageToggle from '../components/LanguageToggle.astro';

const profile = await getEntry('about', 'profile');
if (!profile) throw new Error('Missing src/content/about/profile.yaml');
---

<BaseLayout title="About" description="About Sunwoo Choi and his interests.">
  <section class="container section">
    <h1 class="section-title" lang="en">{profile.data.labels.pageTitle}</h1>
    <LanguageToggle initialLanguage="ko" />
    <div class="about-intro">
      {profile.data.intro.ko.map((paragraph) => <p lang="ko" data-language-fragment="ko">{paragraph}</p>)}
      {profile.data.intro.en.map((paragraph) => <p lang="en" data-language-fragment="en" hidden>{paragraph}</p>)}
    </div>
    <section class="profile-section" aria-labelledby="affiliations-heading">
      <h2 id="affiliations-heading">Selected Affiliations</h2>
      <ol class="affiliations-list" aria-labelledby="affiliations-heading">
        {profile.data.affiliations.map((item) => (
          <li><span class="profile-entry-title" lang="en">{item.title}</span><span class="profile-period">{item.period}</span></li>
        ))}
      </ol>
    </section>
  </section>
</BaseLayout>

<style>
  .about-intro { margin-top: 1.75rem; }
  .about-intro p { margin: 0 0 1rem; font-family: var(--serif-ko); font-size: 1.0625rem; line-height: 1.85; word-break: keep-all; }
  .about-intro p:lang(en) { font-family: var(--serif-display); font-size: 1.3125rem; line-height: 1.65; word-break: normal; }
  .affiliations-list { position: relative; margin: 0; padding: 0 0 0 2rem; list-style: none; }
  .affiliations-list::before { content: ''; position: absolute; top: 1rem; bottom: 1rem; left: 0.5rem; width: 1px; background: var(--line); }
  .affiliations-list li { position: relative; margin: 0 0 1.375rem; padding: 0.625rem 0 0.125rem; }
  .affiliations-list li:last-child { margin-bottom: 0; }
  .affiliations-list li::before { content: ''; position: absolute; z-index: 1; top: 1.02rem; left: -1.75rem; width: 0.5rem; height: 0.5rem; border: 1px solid var(--accent); border-radius: 50%; background: var(--paper); }
  .affiliations-list .profile-entry-title { display: block; }
  .affiliations-list .profile-period { margin-top: 0.125rem; }
  @media (max-width: 45rem) {
    .about-intro p { font-size: 1rem; }
    .about-intro p:lang(en) { font-size: 1.25rem; }
  }
</style>
