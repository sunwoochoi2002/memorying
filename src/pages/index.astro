---
import PersonalIntroduction from '../components/PersonalIntroduction.astro';
import WritingListItem from '../components/WritingListItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadWritingArticles } from '../lib/content';

const writing = await loadWritingArticles();
const recent = writing.slice(0, 6);
---

<BaseLayout title="Home" description="Sunwoo Choi's personal writing and archive." bodyClass="home-page">
  <div class="home-shell">
    <PersonalIntroduction />
    <section class="home-writing" aria-labelledby="recent-writing">
      <div class="home-writing__head">
        <h2 id="recent-writing">Recent writing</h2>
        <a class="text-link" href="/writing/">View all →</a>
      </div>
      {recent.length > 0 ? (
        <ul class="writing-list">
          {recent.map((item) => <li><WritingListItem item={item} headingLevel={3} compact={true} /></li>)}
        </ul>
      ) : <p class="empty-state">첫 번째 글을 준비하고 있습니다.</p>}
    </section>
  </div>
</BaseLayout>
