---
import { render } from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';
import { loadWritingArticleEntries, type LoadedWritingArticle } from '../../lib/content';

export async function getStaticPaths() {
  const pairs = await loadWritingArticleEntries();
  return pairs.map(({ entries, item }) => ({
    params: { slug: item.slug },
    props: { entries, item },
  }));
}

type Props = LoadedWritingArticle;

const { entries, item } = Astro.props;
const { Content: KoreanContent } = await render(entries.ko);
const { Content: EnglishContent } = await render(entries.en);
---

<WritingLayout item={item}>
  <div slot="ko"><KoreanContent /></div>
  <div slot="en"><EnglishContent /></div>
</WritingLayout>
