---
import WritingArchive from '../../components/WritingArchive.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadWritingArticles } from '../../lib/content';
import { loadWritingCategories } from '../../lib/writing-categories';

const writing = await loadWritingArticles();
const categorySlugs = loadWritingCategories().map((category) => category.slug);
---

<BaseLayout title="Writing" description="Essays and notes by Sunwoo Choi." wide>
  <Fragment slot="head">
    <script is:inline define:vars={{ categorySlugs }}>
      // Old links used /writing/?type=<category>; send them to that category's page.
      const type = new URLSearchParams(location.search).get('type');
      if (type !== null && categorySlugs.includes(type)) location.replace(`/writing/category/${type}/`);
    </script>
  </Fragment>
  <WritingArchive writing={writing} />
</BaseLayout>
